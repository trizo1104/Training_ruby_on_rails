- @page_title = t("companies.index.page_title")
- @active_nav = "companies"

.space-y-6
  = render "shared/page_header",
           title: t("companies.index.title"),
           description: t("companies.index.description"),
           action_label: t("companies.index.create"),
           action_path: new_company_path

  .rounded-3xl.border.border-slate-200.bg-white.p-5.shadow-sm
    = form_with url: companies_path, method: :get, class: "flex flex-col gap-3 md:flex-row md:items-end" do |form|
      .flex-1
        = form.label :search,
                     t("companies.index.search_label"),
                     class: "mb-2 block text-sm font-medium text-slate-700"

        = form.search_field :search,
                            value: params[:search],
                            placeholder: t("companies.index.search_placeholder"),
                            class: "w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm outline-none focus:border-sky-500 focus:bg-white"

      = form.submit t("common.actions.filter"),
                    class: "rounded-xl bg-sky-500 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-600"

  - if @companies.empty?
    = render "shared/empty_state",
             title: t("companies.index.empty_title"),
             description: t("companies.index.empty_description"),
             action_label: t("companies.index.create"),
             action_path: new_company_path
  - else
    .grid.gap-4
      - @companies.each do |company|
        %article.flex.flex-col.gap-4.rounded-3xl.border.border-slate-200.bg-white.p-2.shadow-sm.lg:flex-row.lg:items-center.lg:justify-between
          .flex.min-w-0.items-center.gap-4
            .flex.h-16.w-16.shrink-0.items-center.justify-center.rounded-2xl.bg-sky-50.text-sky-600
              %span.text-lg.font-semibold
                = company.name&.first&.upcase

            .min-w-0
              .flex.flex-wrap.items-center.gap-2
                %h4.truncate.text-lg.font-semibold.text-slate-900
                  = company.name

              - if company.address.present?
                %p.mt-2.text-sm.text-slate-500
                  = company.address

              %p.mt-2.text-sm.text-slate-500
                = t("companies.index.metadata",
                    created_at: l(company.created_at, format: :short),
                    updated_at: l(company.updated_at, format: :short))

          -# .flex.gap-3.text-sm
          -#   = link_to t("common.actions.view_details"),
          -#             company_path(company),
          -#             class: "font-semibold text-sky-600 hover:text-sky-700"

          -#   = link_to t("common.actions.edit"),
          -#             edit_company_path(company),
          -#             class: "font-semibold text-slate-600 hover:text-slate-900"

  = render "shared/pagination", pagy: @pagy