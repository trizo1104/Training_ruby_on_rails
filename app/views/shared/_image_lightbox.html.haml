%div{
  class: "fixed inset-0 z-50 hidden bg-slate-900/90 p-4 sm:p-8",
  data: {
    image_lightbox_target: "modal"
  },
  role: "dialog",
  "aria-modal": "true",
  "aria-labelledby": "image-lightbox-caption",
  "aria-hidden": "true"
}
  .flex.h-full.w-full.items-center.justify-center.gap-3.sm:gap-6
    %button{
      class: "rounded-full bg-white/95 p-3 text-slate-700 shadow-lg transition hover:bg-white disabled:cursor-not-allowed disabled:opacity-40",
      type: "button",
      data: {
        image_lightbox_target: "previous",
        action: "click->image-lightbox#previous"
      },
      "aria-label": t("shared.image_lightbox.previous")
    }
      %svg{
        class: "h-5 w-5",
        fill: "none",
        viewBox: "0 0 24 24",
        stroke: "currentColor",
        "stroke-width": "2",
        "aria-hidden": "true"
      }
        %path{
          "stroke-linecap": "round",
          "stroke-linejoin": "round",
          d: "m15 19-7-7 7-7"
        }

    .relative.flex.max-h-full.max-w-6xl.flex-1.flex-col.items-center.justify-center
      %button{
        class: "absolute right-0 top-0 z-10 rounded-full bg-white/95 p-2 text-slate-700 shadow-lg transition hover:bg-white",
        type: "button",
        data: {
          image_lightbox_target: "close",
          action: "click->image-lightbox#close"
        },
        "aria-label": t("shared.image_lightbox.close")
      }
        %svg{
          class: "h-5 w-5",
          fill: "none",
          viewBox: "0 0 24 24",
          stroke: "currentColor",
          "stroke-width": "2",
          "aria-hidden": "true"
        }
          %path{
            "stroke-linecap": "round",
            "stroke-linejoin": "round",
            d: "M6 18 18 6M6 6l12 12"
          }

      %img{
        class: "max-h-[calc(100vh-7rem)] max-w-full rounded-2xl object-contain shadow-lg",
        data: {
          image_lightbox_target: "image"
        },
        alt: ""
      }

      %p{
        id: "image-lightbox-caption",
        class: "mt-3 text-sm font-medium text-white",
        data: {
          image_lightbox_target: "caption"
        }
      }

    %button{
      class: "rounded-full bg-white/95 p-3 text-slate-700 shadow-lg transition hover:bg-white disabled:cursor-not-allowed disabled:opacity-40",
      type: "button",
      data: {
        image_lightbox_target: "next",
        action: "click->image-lightbox#next"
      },
      "aria-label": t("shared.image_lightbox.next")
    }
      %svg{
        class: "h-5 w-5",
        fill: "none",
        viewBox: "0 0 24 24",
        stroke: "currentColor",
        "stroke-width": "2",
        "aria-hidden": "true"
      }
        %path{
          "stroke-linecap": "round",
          "stroke-linejoin": "round",
          d: "m9 5 7 7-7 7"
        }