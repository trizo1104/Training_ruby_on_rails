<% if flash.any? %>
  <div class="mx-4 mt-4 space-y-3 lg:mx-6">
    <% flash.each do |type, message| %>
      <% if message.present? %>
        <% classes = type.to_s == "alert" ? "border-rose-200 bg-rose-50 text-rose-700" : "border-emerald-200 bg-emerald-50 text-emerald-700" %>
        <div class="flex items-start justify-between rounded-xl border px-4 py-3 shadow-sm <%= classes %>" role="alert">
          <div class="flex items-start gap-3">
            <% if type.to_s == "alert" %>
              <svg class="mt-0.5 h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0 3.75h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-2.82 0Z" /></svg>
            <% else %>
              <svg class="mt-0.5 h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
            <% end %>
            <p class="text-sm font-medium"><%= message %></p>
          </div>
          <button type="button" class="rounded-md p-1 text-inherit transition hover:bg-black/5" aria-label="Dismiss notification">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
          </button>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
