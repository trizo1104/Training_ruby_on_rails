- resource = local_assigns[:resource]

- if resource.present? && resource.respond_to?(:errors) && resource.errors.any?
  .rounded-xl.border.border-rose-200.bg-rose-50.p-4.text-sm.text-rose-700{ role: "alert" }
    %p.font-semibold= t("shared.form_errors", count: resource.errors.count)

    %ul.mt-2.list-disc.space-y-1.pl-5
      - resource.errors.full_messages.each do |message|
        %li= message
