<% resource = local_assigns[:resource] %>
<% if resource.present? && resource.respond_to?(:errors) && resource.errors.any? %>
  <div class="rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700" role="alert">
    <p class="font-semibold"><%= pluralize(resource.errors.count, "error") %> prevented this form from being saved.</p>
    <ul class="mt-2 list-disc space-y-1 pl-5">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
