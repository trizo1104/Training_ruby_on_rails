<div class="flex flex-col gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:flex-row sm:items-end sm:justify-between">
  <div>
    <h2 class="text-xl font-semibold tracking-tight text-slate-900"><%= title %></h2>
    <% if local_assigns[:description].present? %>
      <p class="mt-1 text-sm text-slate-500"><%= description %></p>
    <% end %>
  </div>
    <% if local_assigns[:action_label].present? && local_assigns[:action_path].present? %>
      <%= link_to action_label, action_path, class: "inline-flex items-center justify-center rounded-lg bg-sky-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-sky-600" %>
    <% end %>
</div>
