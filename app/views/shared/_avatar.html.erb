<% user = local_assigns[:user]
name ||= user&.full_name || "User"
avatar = local_assigns.key?(:avatar) ? avatar : user&.avatar
size_class = case local_assigns.fetch(:size, "md")
  when "sm" then "h-9 w-9 text-sm"
  when "lg" then "h-14 w-14 text-lg"
  when "xl" then "h-40 w-40 text-4xl"
  else "h-11 w-11 text-base"
  end %>
<div class="<%= size_class %> overflow-hidden rounded-full border border-slate-200 bg-slate-100 text-center font-semibold text-slate-700 shadow-sm">
  <% if avatar&.attached? %>
    <%= image_tag avatar, class: "h-full w-full object-cover", alt: "Avatar for #{name}" %>
  <% else %>
    <% initials = name.to_s.split.filter_map { |part| part[0] }.join.first(2).upcase.presence || "U" %>
    <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-sky-100 to-cyan-100 text-slate-700"><%= initials %></div>
  <% end %>
</div>
