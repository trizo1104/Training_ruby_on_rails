!!!
%html
  %head
    %meta{ charset: "utf-8" }

    :javascript
      function number_pages() {
        var vars = {};
        var query = document.location.search.substring(1).split("&");

        for (var i = 0; i < query.length; i++) {
          var pair = query[i].split("=", 2);

          vars[pair[0]] = decodeURIComponent(pair[1] || "");
        }

        var fields = ["page", "topage"];

        fields.forEach(function(field) {
          var elements = document.getElementsByClassName(field);

          for (var i = 0; i < elements.length; i++) {
            elements[i].textContent = vars[field];
          }
        });
      }

  %body{ onload: "number_pages()" }
    %div{ style: "width:100%; text-align:center; font-size:10px; color:#666;" }
      - page_text = '<span class="page"></span>'
      - total_text = '<span class="topage"></span>'
      = t("assignments.export.page", page: page_text, total: total_text).html_safe
