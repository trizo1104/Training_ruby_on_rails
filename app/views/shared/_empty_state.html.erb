<div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center shadow-sm">
  <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-sky-50 text-sky-600">
    <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
  </div>
  <h3 class="mt-4 text-lg font-semibold text-slate-900"><%= title %></h3>
  <p class="mx-auto mt-2 max-w-md text-sm text-slate-500"><%= description %></p>
  <% if local_assigns[:action_label].present? && local_assigns[:action_path].present? %>
    <%= link_to action_label, action_path, class: "mt-6 inline-flex items-center justify-center rounded-lg bg-sky-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-sky-600" %>
  <% end %>
</div>
