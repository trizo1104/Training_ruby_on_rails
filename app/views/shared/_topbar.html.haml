%header{ class: "border-b border-slate-200 bg-white/95 px-4 py-3 backdrop-blur sm:px-6 lg:fixed lg:left-72 lg:right-0 lg:top-0 lg:z-30 lg:h-20 lg:px-8 lg:py-0" }
  .flex.items-center.justify-between.gap-4.lg:h-full

    .flex.min-w-0.items-center.gap-3
      %button{ type: "button", class: "inline-flex h-10 w-10 items-center justify-center rounded-lg border border-slate-200 text-slate-600 transition hover:bg-slate-50 hover:text-slate-900 lg:hidden", aria: { label: t("shared.navigation.open_menu") } }
        %svg{ class: "h-5 w-5", fill: "none", viewBox: "0 0 24 24", stroke: "currentColor", "stroke-width": "1.8", "aria-hidden": "true" }
          %path{ "stroke-linecap": "round", "stroke-linejoin": "round", d: "M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" }

      %div
        %p{ class: "text-sm font-semibold text-slate-900" }= title
        %p{ class: "text-xs text-slate-500" }= t("app.workspace")

    .hidden.flex-1.items-center.justify-end.gap-3.lg:flex
      = render "shared/locale_switcher"

      .relative{ data: { controller: "dropdown" } }
        %button{ type: "button", class: "flex min-w-40 items-center gap-2 rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-left shadow-sm transition hover:border-slate-300 hover:bg-slate-50", data: { action: "dropdown#toggle", dropdown_target: "button" }, "aria-expanded": "false", "aria-haspopup": "true" }
          = render "shared/avatar", user: current_user, size: "sm"

          .min-w-0.flex-1
            %p{ class: "truncate text-sm font-semibold text-slate-900" }= current_user.full_name
            %p{ class: "truncate text-xs text-slate-500" }= current_user.department

          %svg{ class: "h-4 w-4 text-slate-400", fill: "none", viewBox: "0 0 24 24", stroke: "currentColor", "stroke-width": "1.8", "aria-hidden": "true" }
            %path{ "stroke-linecap": "round", "stroke-linejoin": "round", d: "m19.5 8.25-7.5 7.5-7.5-7.5" }

        %div{ class: "absolute right-0 top-full z-50 mt-2 hidden w-full overflow-hidden rounded-lg border border-slate-200 bg-white py-1 shadow-lg", data: { dropdown_target: "menu" } }
          = link_to profile_path, class: "flex items-center px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 hover:text-slate-900" do
            %span= t("shared.navigation.profile")

          = button_to t("shared.navigation.sign_out"), destroy_user_session_path, method: :delete, class: "flex w-full items-center border-t border-slate-100 px-3 py-2 text-left text-sm font-medium text-slate-700 transition hover:bg-slate-50 hover:text-slate-900"
