<% if pagy && pagy.pages > 1 %>
  <nav class="flex flex-col items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-4 text-sm text-slate-500 shadow-sm sm:flex-row" aria-label="Pagination">
    <p>
      Showing <%= pagy.from %>–<%= pagy.to %>
      of <%= pagy.count %> assignments
    </p>

    <div class="flex items-center gap-2">
      <% if pagy.previous %>
        <%= link_to "Previous",
              url_for(request.query_parameters.merge(page: pagy.previous)),
              class: "rounded-lg border border-slate-200 px-3 py-2 font-medium text-slate-600 hover:bg-slate-50" %>
      <% end %>

      <% pagy.send(:series).each do |page| %>
        <% if page.is_a?(Integer) %>
          <%= link_to page,
                url_for(request.query_parameters.merge(page: page)),
                class: [
                  "rounded-lg px-3 py-2 font-semibold",
                  page == pagy.page ?
                    "bg-sky-500 text-white" :
                    "border border-slate-200 text-slate-600 hover:bg-slate-50"
                ].join(" ") %>
        <% else %>
          <span class="px-2">…</span>
        <% end %>
      <% end %>

      <% if pagy.next %>
        <%= link_to "Next",
              url_for(request.query_parameters.merge(page: pagy.next)),
              class: "rounded-lg border border-slate-200 px-3 py-2 font-medium text-slate-600 hover:bg-slate-50" %>
      <% end %>
    </div>
  </nav>
<% end %>