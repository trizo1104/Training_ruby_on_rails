<h1 style="text-align:center; margin-bottom:30px;">
  <%= t("assignments.export.pdf_title") %>
</h1>

<p>
  <strong><%= t("assignments.export.generated_at") %>:</strong>
  <%= Date.current %>
</p>

<p>
  <strong><%= t("common.labels.user") %>:</strong>
  <%= @user.full_name %>
</p>

<p>
  <strong><%= t("common.labels.email") %>:</strong>
  <%= @user.email %>
</p>

<p>
  <strong><%= t("common.labels.department") %>:</strong>
  <%= @user.department %>
</p>

<hr style="margin:25px 0;">

<% @assignments.each do |assignment| %>

  <%# <div style="
      /* border:1px solid #ccc; */
      padding:18px;
      margin-bottom:25px;
      page-break-inside: avoid;
  "> %>
  <div>

    <h2>
      <%= t("assignments.export.pdf_assignment", id: assignment.id) %>
    </h2>

    <p>
      <strong><%= t("common.labels.status") %>:</strong>
      <%= t("common.labels.#{assignment.status}") %>
    </p>

    <p>
      <strong><%= t("common.labels.content") %></strong>
    </p>

    <%# <div style="
      padding:10px;
      background:#f5f5f5;
      border:1px solid #ddd;
      margin-bottom:15px;
      white-space:pre-wrap;
    "> %>
    <div style=" white-space:pre-wrap; ">
      <%= assignment.content %>
    </div>

    <p>
      <strong><%= t("common.labels.images") %></strong>
    </p>

    <% if assignment.images.attached? %>

      <% assignment.images.each do |image| %>

        <%= image_tag(
              Assignments::ImageEncoder.new(image).data_uri,
              width: 350,
              style: "margin-right:8px; margin-bottom:8px;"
            ) %>

      <% end %>

    <% else %>

      <em><%= t("assignments.export.no_image") %></em>

    <% end %>
  </div>
  
  <hr style="margin:25px 0;">

<% end %>
