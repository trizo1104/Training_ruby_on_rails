<h1>Assignment Report</h1>

<table style="width:100%; border-collapse:collapse;">
  <thead>
    <tr>
      <th style="border:1px solid #000; padding:8px;">ID</th>
      <th style="border:1px solid #000; padding:8px;">Content</th>
      <th style="border:1px solid #000; padding:8px;">Status</th>
      <th style="border:1px solid #000; padding:8px;">Images</th>
    </tr>
  </thead>

  <tbody>
    <% @assignments.each do |assignment| %>
      <tr>
        <td style="border:1px solid #000; padding:8px; vertical-align:top;">
          <%= assignment.id %>
        </td>

        <td style="border:1px solid #000; padding:8px; vertical-align:top;">
          <%= assignment.content %>
        </td>

        <td style="border:1px solid #000; padding:8px; vertical-align:top;">
          <%= assignment.status.humanize %>
        </td>

        <td style="border:1px solid #000; padding:8px;">
          <% if assignment.images.attached? %>
            <% assignment.images.each do |image| %>
              <div style="display:inline-block; margin:4px;">
                <%= image_tag Assignments::ImageEncoder.new(image).data_uri, width: 120 %>
              </div>
            <% end %>
          <% else %>
            No image
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>