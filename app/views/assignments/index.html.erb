<% @page_title = "Assignments" %>
<% @active_nav = "assignments" %>

<div class="space-y-6">
  <%
    export_params =
      request.query_parameters
            .except("page")
            .merge(format: :xlsx)
  %>

  <%= link_to assignments_path(export_params),
              class: "inline-flex items-center gap-2 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700",
              data: { turbo: false } do %>
    Export Excel
  <% end %>

  <%= render "shared/page_header", title: "My assignments", description: "Browse your personal backlog and keep everything moving.", action_label: "Create assignment", action_path: new_assignment_path %>

  <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
    <%= form_with url: assignments_path, method: :get, class: "flex flex-col gap-3 md:flex-row md:items-end" do |form| %>
      <div class="flex-1">
        <%= form.label :search, "Search assignments", class: "mb-2 block text-sm font-medium text-slate-700" %>
        <%= form.search_field :search, value: params[:search], placeholder: "Search content", class: "w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm outline-none focus:border-sky-500 focus:bg-white" %>
      </div>
      <div>
        <%= form.label :status, "Status", class: "mb-2 block text-sm font-medium text-slate-700" %>
        <%= form.select :status, [["All", ""], ["Assigned", "assigned"], ["Finished", "finished"]], { selected: params[:status] }, class: "w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm outline-none focus:border-sky-500 focus:bg-white" %>
      </div>
      <%= form.submit "Filter", class: "rounded-xl bg-sky-500 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-600" %>
    <% end %>
  </div>

  <% if @assignments.empty? %>
    <%= render "shared/empty_state", title: "No assignments yet", description: "Create your first assignment to start building your workspace.", action_label: "Create assignment", action_path: new_assignment_path %>
  <% else %>
    <div class="grid gap-4">
      <% @assignments.each do |assignment| %>
        <article class="flex flex-col gap-4 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm lg:flex-row lg:items-center lg:justify-between">
          <div class="flex min-w-0 items-start gap-4">
            <% if assignment.images.attached? %>
              <div class="shrink-0" data-image-lightbox-gallery>
                <button type="button" class="block cursor-zoom-in rounded-2xl focus:outline-none focus:ring-2 focus:ring-sky-500 focus:ring-offset-2" data-action="click->image-lightbox#open" data-image-lightbox-url="<%= url_for(assignment.images.first) %>" data-image-lightbox-alt="Assignment image">
                  <%= image_tag assignment.images.first, class: "h-16 w-24 rounded-2xl object-cover", alt: "Assignment image", loading: "lazy" %>
                </button>
                <% assignment.images.drop(1).each do |image| %>
                  <button type="button" class="hidden" data-action="click->image-lightbox#open" data-image-lightbox-url="<%= url_for(image) %>" data-image-lightbox-alt="Assignment image" aria-hidden="true" tabindex="-1"></button>
                <% end %>
              </div>
            <% else %>
              <div class="flex h-16 w-24 shrink-0 items-center justify-center rounded-2xl bg-sky-50 text-sky-600">
                <span class="text-xs font-semibold">No image</span>
              </div>
            <% end %>
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h4 class="truncate text-lg font-semibold text-slate-900"><%= truncate(assignment.content, length: 70) %></h4>
                <%= render "shared/status_badge", status: assignment.status %>
              </div>
              <p class="mt-2 text-sm text-slate-500"><%= pluralize(assignment.images.size, "image") %> · Created <%= l(assignment.created_at, format: :short) %> · Updated <%= l(assignment.updated_at, format: :short) %></p>
            </div>
          </div>
          <div class="flex gap-3 text-sm">
            <%= link_to "View details", assignment_path(assignment), class: "font-semibold text-sky-600 hover:text-sky-700" %>
            <%= link_to "Edit", edit_assignment_path(assignment), class: "font-semibold text-slate-600 hover:text-slate-900" %>
          </div>
        </article>
      <% end %>
    </div>
  <% end %>

  <%= render "shared/pagination", pagy: @pagy %>
</div>
