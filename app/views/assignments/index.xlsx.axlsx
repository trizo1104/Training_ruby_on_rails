workbook = xlsx_package.workbook

styles = workbook.styles

title_style = styles.add_style(
  bg_color: "1E293B",
  fg_color: "FFFFFF",
  b: true,
  sz: 16,
  alignment: {
    horizontal: :center,
    vertical: :center
  }
)

header_style = styles.add_style(
  bg_color: "E2E8F0",
  fg_color: "0F172A",
  b: true,
  border: {
    style: :thin,
    color: "CBD5E1"
  },
  alignment: {
    horizontal: :center,
    vertical: :center
  }
)

cell_style = styles.add_style(
  border: {
    style: :thin,
    color: "E2E8F0"
  },
  alignment: {
    vertical: :center,
    wrap_text: true
  }
)

center_cell_style = styles.add_style(
  border: {
    style: :thin,
    color: "E2E8F0"
  },
  alignment: {
    horizontal: :center,
    vertical: :center
  }
)

date_style = styles.add_style(
  format_code: "dd/mm/yyyy hh:mm",
  border: {
    style: :thin,
    color: "E2E8F0"
  },
  alignment: {
    horizontal: :center,
    vertical: :center
  }
)

workbook.add_worksheet(name: "Assignments") do |sheet|
  sheet.add_row(
    ["MY ASSIGNMENTS REPORT"],
    style: title_style,
    height: 30
  )

  sheet.merge_cells("A1:E1")

  sheet.add_row(
    [
      "Generated by",
      current_user.full_name,
      nil,
      "Generated at",
      Time.current
    ]
  )

  sheet.add_row []

  sheet.add_row(
    [
      "No.",
      "Content",
      "Status",
      "Images",
      "Created at"
    ],
    style: header_style,
    height: 24
  )

@assignments.each_with_index do |assignment, assignment_index|
  image_paths = @export_image_paths.fetch(assignment.id, [])

  # Assignment không có ảnh vẫn cần ít nhất một dòng
  row_count = [image_paths.size, 1].max

  # Số dòng Excel trước khi thêm assignment hiện tại
  first_row_number = sheet.rows.size + 1

  row_count.times do |image_index|
    sheet.add_row(
      [
        image_index.zero? ? assignment_index + 1 : nil,
        image_index.zero? ? assignment.content : nil,
        image_index.zero? ? assignment.status.titleize : nil,
        nil,
        image_index.zero? ? assignment.created_at : nil
      ],
      style: [
        center_cell_style,
        cell_style,
        center_cell_style,
        center_cell_style,
        date_style
      ],
      height: image_paths.any? ? 90 : 30
    )

    image_path = image_paths[image_index]

    next unless image_path

    # sheet.rows.size - 1 vì vị trí ảnh dùng index bắt đầu từ 0
    current_row_index = sheet.rows.size - 1

    sheet.add_image(
      image_src: image_path,
    ) do |image|
      image.width = 80
      image.height = 80

      # Cột D có index là 3
      image.start_at(
        3,
        current_row_index
      )
    end
  end

  last_row_number = first_row_number + row_count - 1

  # Chỉ merge khi assignment có nhiều hơn một dòng
  if row_count > 1
    sheet.merge_cells("A#{first_row_number}:A#{last_row_number}")
    sheet.merge_cells("B#{first_row_number}:B#{last_row_number}")
    sheet.merge_cells("C#{first_row_number}:C#{last_row_number}")
    sheet.merge_cells("E#{first_row_number}:E#{last_row_number}")
  end
end

  sheet.column_widths 8, 45, 16, 38, 22
  # sheet.auto_filter = "A4:E4"

  sheet.sheet_view.pane do |pane|
    pane.state = :frozen
    pane.top_left_cell = "A5"
    pane.y_split = 4
  end
end