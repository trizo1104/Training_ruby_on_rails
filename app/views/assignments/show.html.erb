<% @page_title = t("assignments.show.page_title") %>
<% @active_nav = "assignments" %>

<div class="space-y-6">
  <%= render "shared/page_header", title: t("assignments.show.title"), description: t("assignments.show.description"), action_label: t("common.actions.edit"), action_path: edit_assignment_path(@assignment) %>

  <div class="grid gap-6 lg:grid-cols-[1fr_0.8fr]">
    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h3 class="text-xl font-semibold text-slate-900"><%= t("assignments.show.assignment_content") %></h3>
        <%= render "shared/status_badge", status: @assignment.status %>
      </div>
      <p class="mt-6 whitespace-pre-wrap text-sm leading-7 text-slate-600"><%= @assignment.content %></p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <% [[t("common.labels.owner"), @assignment.user.full_name], [t("common.labels.department"), @assignment.user.department], [t("common.labels.images"), t("common.image_count", count: @assignment.images.count)], [t("common.labels.created"), l(@assignment.created_at, format: :short)], [t("common.labels.updated"), l(@assignment.updated_at, format: :short)]].each do |label, value| %>
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
            <p class="text-sm text-slate-500"><%= label %></p>
            <p class="mt-2 font-semibold text-slate-900"><%= value %></p>
          </div>
        <% end %>
      </div>
      <div class="mt-6 flex flex-wrap gap-3">
        <%= link_to t("assignments.edit.title"), edit_assignment_path(@assignment), class: "rounded-lg bg-sky-500 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-600" %>
        <%= button_to t("assignments.show.delete"), assignment_path(@assignment), method: :delete, class: "rounded-lg border border-rose-200 px-4 py-2 text-sm font-semibold text-rose-600 hover:bg-rose-50", form: { data: { turbo_confirm: t("assignments.show.delete_confirm") } } %>
      </div>
    </section>

    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
      <h3 class="text-lg font-semibold text-slate-900"><%= t("assignments.show.attached_images") %></h3>
      <% if @assignment.images.attached? %>
        <div class="mt-4 grid gap-3 sm:grid-cols-2" data-image-lightbox-gallery>
          <% @assignment.images.each do |image| %>
            <button type="button" class="block w-full cursor-zoom-in rounded-2xl focus:outline-none focus:ring-2 focus:ring-sky-500 focus:ring-offset-2" data-action="click->image-lightbox#open" data-image-lightbox-url="<%= url_for(image) %>" data-image-lightbox-alt="<%= t('assignments.form.image_alt') %>">
              <%= image_tag image, class: "h-36 w-full rounded-2xl object-cover", alt: t("assignments.form.image_alt"), loading: "lazy" %>
            </button>
          <% end %>
        </div>
      <% else %>
        <%= image_tag "assignment-placeholder.svg", class: "mt-4 h-48 w-full rounded-2xl object-cover", alt: t("assignments.show.no_images_alt") %>
        <p class="mt-4 text-sm text-slate-500"><%= t("assignments.show.no_images") %></p>
      <% end %>
    </section>
  </div>
</div>
