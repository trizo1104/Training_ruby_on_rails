<%= form_with model: assignment, class: "space-y-6", multipart: true do |form| %>
  <%= render "shared/form_errors", resource: assignment %>

  <div>
    <%= form.label :content, t("assignments.form.content"), class: "mb-2 block text-sm font-medium text-slate-700" %>
    <%= form.text_area :content, rows: 7, required: true, placeholder: t("assignments.form.content_placeholder"), class: "w-full rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700 outline-none transition focus:border-sky-500 focus:bg-white focus:ring-2 focus:ring-sky-500/20" %>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4" data-controller="file-upload" data-file-upload-max-files-value="10" data-file-upload-max-size-value="10485760">
    <div class="flex items-center justify-between gap-3">
      <div>
        <h3 class="text-sm font-semibold text-slate-900"><%= t("assignments.form.images") %></h3>
        <p class="mt-1 text-xs text-slate-500"><%= t("assignments.form.image_hint") %></p>
      </div>
      <span class="text-xs font-medium text-slate-500"><%= t("assignments.form.images_finish") %></span>
    </div>

    <% if assignment.persisted? && assignment.images.attached? %>
      <div class="mt-4">
        <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("assignments.form.existing_images") %></p>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-4" data-image-lightbox-gallery>
          <% assignment.images.attachments.each do |attachment| %>
            <div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
              <button type="button" class="block w-full cursor-zoom-in focus:outline-none focus:ring-2 focus:ring-inset focus:ring-sky-500" data-action="click->image-lightbox#open" data-image-lightbox-url="<%= url_for(attachment) %>" data-image-lightbox-alt="<%= t('assignments.form.image_alt') %>">
                <%= image_tag attachment, class: "h-24 w-full object-cover", alt: t("assignments.form.image_alt") %>
              </button>
              <%#= link_to "Remove", assignment_image_path(assignment, attachment_id: attachment.id), method: :delete, class: "w-full border-t border-slate-200 px-2 py-2 text-xs font-semibold text-rose-600 hover:bg-rose-50", form: { data: { turbo_confirm: "Remove this image?" } } %>
            <%= link_to t("common.actions.remove"),
                assignment_image_path(assignment, attachment_id: attachment.id),
                data: {
                  turbo_method: :delete,
                  turbo_confirm: t("assignments.form.remove_confirm")
                },
                class: "block w-full border-t border-slate-200 px-2 py-2 text-center text-xs font-semibold text-rose-600 hover:bg-rose-50"
            %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <label for="assignment_images" class="mt-4 block cursor-pointer rounded-2xl border-2 border-dashed border-slate-300 bg-white p-6 text-center outline-none transition hover:border-sky-400 focus-within:border-sky-500" data-file-upload-target="dropzone" tabindex="0">
      <span class="text-sm font-semibold text-slate-700"><%= t("assignments.form.dropzone") %></span>
      <span class="mt-1 block text-xs text-slate-500"><%= t("assignments.form.select_limit") %></span>
      <%= form.file_field :images, multiple: true, accept: "image/jpeg,image/png,image/webp", class: "sr-only", data: { file_upload_target: "input", action: "change->file-upload#select keydown->file-upload#activate" } %>
    </label>
    <p class="mt-2 text-sm text-rose-600" data-file-upload-target="message" role="alert" aria-live="polite"></p>
    <div class="mt-4 grid gap-3 sm:grid-cols-2" data-file-upload-target="previewContainer"></div>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200 p-4">
    <div>
      <p class="text-sm font-semibold text-slate-900"><%= t("assignments.form.current_status") %></p>
      <p class="mt-1 text-sm text-slate-500"><%= t("assignments.form.status_hint") %></p>
    </div>
    <%= render "shared/status_badge", status: assignment.status || "assigned" %>
  </div>

  <div class="flex flex-wrap gap-3">
    <%= form.submit assignment.persisted? ? t("assignments.form.update") : t("assignments.form.save"), class: "inline-flex items-center justify-center rounded-lg bg-sky-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-sky-600 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:ring-offset-2" %>
    <%= link_to t("common.actions.cancel"), assignment.persisted? ? assignment_path(assignment) : assignments_path, class: "inline-flex items-center justify-center rounded-lg border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>
  </div>
<% end %>
