= form_with model: assignment, class: "space-y-6", multipart: true do |form|
  - if current_user.has_role?("Admin")
    .rounded-2xl.border.border-slate-200.bg-slate-50.p-4{
      data: { controller: "assignment-company-manager", assignment_company_manager_managers_url_value: managers_users_path }
    }
      .grid.gap-4.sm:grid-cols-2
        %div
          = form.label :company_id,
            t("assignments.form.company"),
            class: "mb-2 block text-sm font-medium text-slate-700"

          = select_tag "assignment[company_id]",
            options_from_collection_for_select(@companies, :id, :name, assignment.company_id),
            include_blank: t("common.labels.select_company"),
            class: "w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm outline-none focus:border-sky-500 focus:bg-white",
            data: { assignment_company_manager_target: "company", action: "change->assignment-company-manager#companyChanged" }

        %div
          = form.label :user_id,
            t("assignments.form.manager"),
            class: "mb-2 block text-sm font-medium text-slate-700"

          = select_tag "assignment[user_id]",
            nil,
            include_blank: t("common.labels.select_manager"),
            class: "w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm outline-none focus:border-sky-500 focus:bg-white",
            data: { assignment_company_manager_target: "manager" }

  = render "shared/form_errors", resource: assignment

  %div
    = form.label :content,
      t("assignments.form.content"),
      class: "mb-2 block text-sm font-medium text-slate-700"

    = form.text_area :content,
      rows: 7,
      required: true,
      placeholder: t("assignments.form.content_placeholder"),
      class: "w-full rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700 outline-none transition focus:border-sky-500 focus:bg-white focus:ring-2 focus:ring-sky-500/20"

  .rounded-2xl.border.border-slate-200.bg-slate-50.p-4{
    data: {
      controller: "file-upload",
      file_upload_max_files_value: 10,
      file_upload_max_size_value: 10485760
    }
  }
    .flex.items-center.justify-between.gap-3
      %div
        %h3.text-sm.font-semibold.text-slate-900
          = t("assignments.form.images")

        %p.mt-1.text-xs.text-slate-500
          = t("assignments.form.image_hint")

      %span.text-xs.font-medium.text-slate-500
        = t("assignments.form.images_finish")

    - if assignment.persisted? && assignment.assignment_images.exists?
      .mt-4
        %p.mb-2.text-xs.font-semibold.uppercase.tracking-wide.text-slate-500
          = t("assignments.form.existing_images")

        .grid.grid-cols-2.gap-3.sm:grid-cols-4{
          data: {
            image_lightbox_gallery: true,
            controller: "sortable",
            sortable_input_id_value: "assignment_image_ids"
          }
        }
          - assignment.assignment_images.each do |assignment_image|
            .overflow-hidden.rounded-xl.border.border-slate-200.bg-white{
              data: {
                sortable_id: assignment_image.id
              }
            }
              %button.block.w-full.cursor-zoom-in.focus:outline-none.focus:ring-2.focus:ring-inset.focus:ring-sky-500{
                type: "button",
                data: {
                  action: "click->image-lightbox#open",
                  image_lightbox_url: url_for(assignment_image.image),
                  image_lightbox_alt: t("assignments.form.image_alt")
                }
              }
                = image_tag assignment_image.image,
                  class: "h-24 w-full object-cover",
                  alt: t("assignments.form.image_alt")

              = link_to t("common.actions.remove"),
                assignment_image_path(assignment,attachment_id: assignment_image.id),
                data: {turbo_method: :delete, turbo_confirm: t("assignments.form.remove_confirm")},
                class: "block w-full border-t border-slate-200 px-2 py-2 text-center text-xs font-semibold text-rose-600 hover:bg-rose-50"

    %label.mt-4.block.cursor-pointer.rounded-2xl.border-2.border-dashed.border-slate-300.bg-white.p-6.text-center.outline-none.transition.hover:border-sky-400.focus-within:border-sky-500{
      for: "assignment_images",
      data: {
        file_upload_target: "dropzone"
      },
      tabindex: 0
    }
      %span.text-sm.font-semibold.text-slate-700
        = t("assignments.form.dropzone")

      %span.mt-1.block.text-xs.text-slate-500
        = t("assignments.form.select_limit")

      = form.file_field :images,
        multiple: true,
        accept: "image/jpeg,image/png,image/webp",
        class: "sr-only",
        data: {file_upload_target: "input", action: "change->file-upload#select keydown->file-upload#activate"}

    %p.mt-2.text-sm.text-rose-600{
      data: {
        file_upload_target: "message"
      },
      role: "alert",
      aria: {
        live: "polite"
      }
    }

    .mt-4.grid.gap-3.sm:grid-cols-2{
      data: {
        file_upload_target: "previewContainer"
      }
    }

  .flex.flex-wrap.items-center.justify-between.gap-3.rounded-2xl.border.border-slate-200.p-4
    %div
      %p.text-sm.font-semibold.text-slate-900
        = t("assignments.form.current_status")

      %p.mt-1.text-sm.text-slate-500
        = t("assignments.form.status_hint")

    = render "shared/status_badge",
      status: assignment.status || "assigned"

  = hidden_field_tag :image_ids,
    assignment.assignment_images.pluck(:id).join(","),
    id: "assignment_image_ids"

  .flex.flex-wrap.gap-3
    = form.submit(assignment.persisted? ? t("assignments.form.update") : t("assignments.form.save"), class: "inline-flex items-center justify-center rounded-lg bg-sky-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-sky-600 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:ring-offset-2")

    = link_to(t("common.actions.cancel"), assignment.persisted? ? assignment_path(assignment) : assignments_path, class: "inline-flex items-center justify-center rounded-lg border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50")
