<% @page_title = "Profile" %>
<% @active_nav = "profile" %>

<div class="space-y-6">
  <%= render "shared/page_header", title: "Profile overview", description: "Your personal details and workspace information.", action_label: "Edit profile", action_path: edit_profile_path %>
  <div class="grid gap-6 lg:grid-cols-[0.85fr_1.15fr]">
    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="flex flex-col items-center text-center">
        <%= render "shared/avatar", user: @user, size: "xl" %>
        <h3 class="mt-4 text-xl font-semibold text-slate-900"><%= @user.full_name %></h3>
        <p class="mt-2 text-sm text-slate-500"><%= @user.department %></p>
        <p class="mt-4 text-sm text-slate-500"><%= pluralize(@user.assignments.count, "assignment") %></p>
      </div>
    </section>
    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
      <h3 class="text-lg font-semibold text-slate-900">About</h3>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <% [["Email", @user.email], ["Username", @user.username], ["Department", @user.department], ["Joined", l(@user.created_at, format: :long)]].each do |label, value| %>
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
            <p class="text-sm text-slate-500"><%= label %></p>
            <p class="mt-2 font-semibold text-slate-900"><%= value %></p>
          </div>
        <% end %>
      </div>
    </section>
  </div>
</div>
