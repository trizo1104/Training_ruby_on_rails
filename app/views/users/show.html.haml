- @page_title = t("users.show.page_title")
- @active_nav = "profile"

- edit_path = @user == current_user ? edit_profile_path : edit_user_path(@user)

.space-y-6
  = render "shared/page_header", title: t("users.show.title"), description: t("users.show.description"), action_label: t("users.show.edit"), action_path: edit_path

  %div{ class: "grid gap-6 lg:grid-cols-[0.85fr_1.15fr]" }

    %section{ class: "rounded-3xl border border-slate-200 bg-white p-6 shadow-sm" }
      .flex.flex-col.items-center.text-center
        = render "shared/avatar", user: @user, size: "xl"

        %h3.mt-4.text-xl.font-semibold.text-slate-900
          = @user.full_name

        %p.mt-2.text-sm.text-slate-500
          = @user.department

        %p.mt-4.text-sm.text-slate-500
          = t("common.assignment_count", count: @user.assignments.count)

    %section{ class: "rounded-3xl border border-slate-200 bg-white p-6 shadow-sm" }
      %h3.text-lg.font-semibold.text-slate-900
        = t("users.show.about")

      .mt-6.grid.gap-4.sm:grid-cols-2

        - user_info = [[t("common.labels.email"), @user.email], [t("common.labels.username"), @user.username], [t("common.labels.department"), @user.department], [t("common.labels.role"), @user.roles.first&.name], [t("common.labels.company"), @user.company&.name], [t("users.show.joined"), l(@user.created_at, format: :long)]]

        - user_info.each do |label, value|
          %div{ class: "rounded-2xl border border-slate-200 bg-slate-50 p-4" }
            %p.text-sm.text-slate-500
              = label

            %p.mt-2.font-semibold.text-slate-900
              = value.presence || "-"

        - unless @user.has_role?("Manager")
          %div{ class: "rounded-2xl border border-slate-200 bg-slate-50 p-4" }
            %p.text-sm.text-slate-500
              = t("common.labels.manager")

            %p.mt-2.font-semibold.text-slate-900
              = @user.manager&.full_name.presence || "-"
