<div class="grid gap-4 border-t border-slate-200 pt-6 md:grid-cols-2">

  <!-- Password -->
  <div>

    <%= form.label :password,
                   t("users.form.password"),
                   class: "mb-2 block text-sm font-medium text-slate-700" %>

    <%= form.password_field :password,
                            required: true,
                            class: "w-full rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm outline-none focus:border-sky-500 focus:bg-white" %>

  </div>


  <!-- Password confirmation -->
  <div>

    <%= form.label :password_confirmation,
                   t("users.form.password_confirmation"),
                   class: "mb-2 block text-sm font-medium text-slate-700" %>

    <%= form.password_field :password_confirmation,
                            required: true,
                            class: "w-full rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm outline-none focus:border-sky-500 focus:bg-white" %>

  </div>

</div>