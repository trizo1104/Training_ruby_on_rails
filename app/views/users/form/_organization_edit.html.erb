<div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
  <h3 class="mb-4 text-lg font-semibold text-slate-900">
    <%= t("users.form.organization") %>
  </h3>

  <div class="grid gap-4 md:grid-cols-2">

    <!-- Role -->
    <div>
      <p class="mb-2 block text-sm font-medium text-slate-700">
        <%= t("users.form.role") %>
      </p>

      <div class="rounded-2xl border border-slate-200 bg-slate-100 px-3 py-2.5 text-sm text-slate-600">
        <%= @user.roles.first&.name || "-" %>
      </div>
    </div>

    <!-- Company -->
    <div>
      <p class="mb-2 block text-sm font-medium text-slate-700">
        <%= t("users.form.company") %>
      </p>

      <div class="rounded-2xl border border-slate-200 bg-slate-100 px-3 py-2.5 text-sm text-slate-600">
        <%= @user.company&.name || "-" %>
      </div>
    </div>

    <!-- Manager -->
    <div class="md:col-span-2">
      <%= form.label :manager_id,
                     t("users.form.manager"),
                     class: "mb-2 block text-sm font-medium text-slate-700" %>

      <% if current_user.has_role?("Admin") ||
            current_user.has_role?("Manager") %>

        <%= form.collection_select :manager_id,
                                   @managers,
                                   :id,
                                   :full_name,
                                   {
                                     selected: @user.manager_id,
                                     prompt: t("users.form.select_manager")
                                   },
                                   {
                                     class: "w-full rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-sm outline-none focus:border-sky-500"
                                   } %>

      <% else %>

        <div class="rounded-2xl border border-slate-200 bg-slate-100 px-3 py-2.5 text-sm text-slate-600">
          <%= @user.manager&.full_name || "-" %>
        </div>

      <% end %>
    </div>

  </div>
</div>