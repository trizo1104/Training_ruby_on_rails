%div{ class: "rounded-3xl border border-slate-200 bg-slate-50 p-5", data: { controller: "company-manager", company_manager_managers_url_value: managers_users_path } }
  %h3.mb-4.text-lg.font-semibold.text-slate-900
    = t("users.form.organization")

  .grid.gap-4.md:grid-cols-2

    -# Role
    %div
      = form.label :role_id, t("users.form.role"), class: "mb-2 block text-sm font-medium text-slate-700"

      - role_options = options_from_collection_for_select(@roles, :id, :name, params.dig(:user, :role_id))
      = select_tag "user[role_id]", role_options, prompt: t("users.form.select_role"), class: "w-full rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-sm outline-none focus:border-sky-500", data: { company_manager_target: "role", action: "change->company-manager#roleChanged" }

    -# Company
    %div
      = form.label :company_id, t("users.form.company"), class: "mb-2 block text-sm font-medium text-slate-700"

      = form.collection_select :company_id, @companies, :id, :name, { prompt: t("users.form.select_company") }, { class: "w-full rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-sm outline-none focus:border-sky-500", data: { company_manager_target: "company", action: "change->company-manager#companyChanged" } }

    -# Manager
    %div{ class: "md:col-span-2", data: { company_manager_target: "managerContainer" } }
      = form.label :manager_id, t("users.form.manager"), class: "mb-2 block text-sm font-medium text-slate-700"

      = form.select :manager_id, [], { prompt: t("users.form.select_manager") }, { class: "w-full rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-sm outline-none focus:border-sky-500", disabled: true, data: { company_manager_target: "manager" } }
