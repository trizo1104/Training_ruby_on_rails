- @page_title = t("users.index.page_title")
- @active_nav = "users"

.space-y-6
  = render "shared/page_header",
           title: t("users.index.title"),
           description: t("users.index.description"),
           action_label: t("users.index.create"),
           action_path: new_user_path

  .rounded-3xl.border.border-slate-200.bg-white.p-5.shadow-sm
    = form_with url: users_path, method: :get, class: "flex flex-col gap-3 md:flex-row md:items-end" do |form|
      .flex-1
        = form.label :search,
                     t("users.index.search_label"),
                     class: "mb-2 block text-sm font-medium text-slate-700"

        = form.search_field :search,
                            value: params[:search],
                            placeholder: t("users.index.search_placeholder"),
                            class: "w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm outline-none focus:border-sky-500 focus:bg-white"

      = form.submit t("common.actions.filter"),
                    class: "rounded-xl bg-sky-500 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-600"

  - if @users.empty?
    = render "shared/empty_state",
             title: t("users.index.empty_title"),
             description: t("users.index.empty_description"),
             action_label: t("users.index.create"),
             action_path: new_user_path
  - else
    .grid.gap-4
      - @users.each do |user|
        %article.flex.flex-col.gap-4.rounded-3xl.border.border-slate-200.bg-white.p-4.shadow-sm.lg:flex-row.lg:items-center.lg:justify-between
          .flex.min-w-0.items-start.gap-4
            - if user.avatar.attached?
              = image_tag user.avatar,
                          class: "h-16 w-16 shrink-0 rounded-2xl object-cover",
                          alt: user.full_name,
                          loading: "lazy"
            - else
              .flex.h-16.w-16.shrink-0.items-center.justify-center.rounded-2xl.bg-sky-50.text-sky-600
                %span.text-lg.font-semibold
                  = user.first_name&.first&.upcase

            .min-w-0
              .flex.flex-wrap.items-center.gap-2
                %h4.truncate.text-lg.font-semibold.text-slate-900
                  = user.full_name

              %p.mt-1.text-sm.text-slate-500
                = user.email

              %p.mt-2.text-sm.text-slate-500
                = t("users.index.metadata",
                    role: user.roles.first&.name,
                    department: user.department,
                    company: user.company&.name,
                    address: user.company&.address)

          .flex.gap-3.text-sm
            = link_to t("common.actions.view_details"),
                      user_path(user),
                      class: "font-semibold text-sky-600 hover:text-sky-700"

            = link_to t("common.actions.edit"),
                      edit_user_path(user),
                      class: "font-semibold text-slate-600 hover:text-slate-900"

  = render "shared/pagination", pagy: @pagy

