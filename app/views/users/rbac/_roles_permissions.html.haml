.rounded-3xl.border.border-slate-200.bg-white.p-5.shadow-sm
  .mb-5
    %h2.text-lg.font-semibold.text-slate-900
      Roles → Permissions

    %p.mt-1.text-sm.text-slate-500
      Assign permissions to each role.

  .overflow-x-auto
    %table.w-full.min-w-max.text-sm
      %thead
        %tr.border-b.border-slate-200
          %th.sticky.left-0.bg-white.px-4.py-3.text-left.font-semibold.text-slate-700
            Resource

          %th.bg-white.px-4.py-3.text-left.font-semibold.text-slate-700
            Action

          - roles.each do |role|
            %th.px-6.py-3.text-center.font-semibold.text-slate-700{
              data: {
                rbac_role_id: role.id,
                rbac_original_permission_ids: role.permissions.map(&:id).to_json
              }
            }
              = role.name

      %tbody
        - permissions.each do |resource, resource_permissions|
          - resource_permissions.each_with_index do |permission, index|
            %tr.border-b.border-slate-100.hover:bg-slate-50
              %td.sticky.left-0.bg-white.px-4.py-4
                - if index == 0
                  %span.font-semibold.text-slate-900
                    = resource

              %td.px-4.py-4
                %span.text-sm.text-slate-700
                  = permission.action

              - roles.each do |role|
                %td.px-6.py-4.text-center
                  = check_box_tag nil, permission.id, role.permissions.include?(permission), disabled: !role.editable?, data: {action: "change->rbac#permissionChanged", rbac_permission_role_id: role.id, rbac_permission_id: permission.id}, class: "h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500"