.rounded-3xl.border.border-slate-200.bg-white.p-5.shadow-sm
  .mb-5
    %h2.text-lg.font-semibold.text-slate-900
      Create Role

    %p.mt-1.text-sm.text-slate-500
      Create a new role for the system.

  = form_with model: Role.new,
              url: admin_rbac_roles_path,
              method: :post,
              data: { turbo: false } do |form|

    .grid.gap-4.md:grid-cols-2
      .space-y-2
        = form.label :name,
                     "Role name",
                     class: "block text-sm font-medium text-slate-700"

        = form.text_field :name,
                          class: "w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm outline-none focus:border-sky-500 focus:bg-white"

      .space-y-2
        = form.label :description,
                     "Description",
                     class: "block text-sm font-medium text-slate-700"

        = form.text_field :description,
                          class: "w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm outline-none focus:border-sky-500 focus:bg-white"

    .mt-5
      = form.submit "Create Role",
                    class: "rounded-xl bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700"