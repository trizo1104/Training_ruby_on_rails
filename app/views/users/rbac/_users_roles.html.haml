.rounded-3xl.border.border-slate-200.bg-white.p-5.shadow-sm
  .mb-5
    %h2.text-lg.font-semibold.text-slate-900
      Users → Roles

    %p.mt-1.text-sm.text-slate-500
      Assign one or more roles to each user.

  .overflow-x-auto
    %table.w-full.min-w-max.text-sm
      %thead
        %tr.border-b.border-slate-200
          %th.sticky.left-0.bg-white.px-4.py-3.text-left.font-semibold.text-slate-700
            User

          - roles.each do |role|
            %th.px-6.py-3.text-center.font-semibold.text-slate-700
              = role.name

      %tbody
        - users.each do |user|
          %tr.border-b.border-slate-100

            %td.sticky.left-0.bg-white.px-4.py-4
              = link_to user_path(user), class: "block" do
                .flex.items-center.gap-3

                  - if user.avatar.attached?
                    = image_tag user.avatar, class: "h-10 w-10 rounded-xl object-cover", alt: user.full_name, loading: "lazy"
                  - else
                    .flex.h-10.w-10.items-center.justify-center.rounded-xl.bg-sky-50.text-sky-600
                      = user.first_name&.first&.upcase

                  .min-w-0
                    %p.font-medium.text-slate-900
                      = user.full_name

                    %p.text-xs.text-slate-500
                      = user.email

            - roles.each do |role|
              %td.px-6.py-4.text-center
                = check_box_tag "user_roles[#{user.id}][]", role.id, user.roles.include?(role), form: "rbac-form", class: "h-4 w-4 rounded border-slate-300 text-sky-600 focus:ring-sky-500"