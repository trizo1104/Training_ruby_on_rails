<% @page_title = "Create account" %>
<% content_for :title, "Create account" %>

<div class="space-y-6">
  <div class="text-center">
    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-sky-500 text-lg font-semibold text-white">TF</div>
    <h2 class="mt-4 text-2xl font-semibold text-slate-900">Create your account</h2>
    <p class="mt-2 text-sm text-slate-500">Join TaskFlow to keep your assignments organized.</p>
  </div>

  <%= render "shared/form_errors", resource: resource %>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <div>
      <%= f.label :username, class: "mb-2 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :username, autocomplete: "username", class: "w-full rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700 outline-none transition focus:border-sky-500 focus:bg-white focus:ring-2 focus:ring-sky-500/20", placeholder: "alex" %>
    </div>

    <div>
      <%= f.label :first_name, class: "mb-2 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :first_name, autofocus: true, autocomplete: "given-name", class: "w-full rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700 outline-none transition focus:border-sky-500 focus:bg-white focus:ring-2 focus:ring-sky-500/20", placeholder: "Alex" %>
    </div>

    <div>
      <%= f.label :last_name, class: "mb-2 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :last_name, autocomplete: "family-name", class: "w-full rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700 outline-none transition focus:border-sky-500 focus:bg-white focus:ring-2 focus:ring-sky-500/20", placeholder: "Johnson" %>
    </div>

    <div>
      <%= f.label :email, class: "mb-2 block text-sm font-medium text-slate-700" %>
      <%= f.email_field :email, autocomplete: "email", class: "w-full rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700 outline-none transition focus:border-sky-500 focus:bg-white focus:ring-2 focus:ring-sky-500/20", placeholder: "you@example.com" %>
    </div>

    <div>
      <%= f.label :department, class: "mb-2 block text-sm font-medium text-slate-700" %>
      <%= f.text_field :department, autocomplete: "organization", class: "w-full rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700 outline-none transition focus:border-sky-500 focus:bg-white focus:ring-2 focus:ring-sky-500/20", placeholder: "Engineering" %>
    </div>

    <div>
      <%= f.label :password, class: "mb-2 block text-sm font-medium text-slate-700" %>
      <%= f.password_field :password, autocomplete: "new-password", class: "w-full rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700 outline-none transition focus:border-sky-500 focus:bg-white focus:ring-2 focus:ring-sky-500/20", placeholder: "••••••••" %>
    </div>

    <div>
      <%= f.label :password_confirmation, class: "mb-2 block text-sm font-medium text-slate-700" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700 outline-none transition focus:border-sky-500 focus:bg-white focus:ring-2 focus:ring-sky-500/20", placeholder: "••••••••" %>
    </div>

    <%= f.submit "Create account", class: "inline-flex w-full items-center justify-center rounded-lg bg-sky-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-sky-600 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:ring-offset-2" %>
  <% end %>
</div>
