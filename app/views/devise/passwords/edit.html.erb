<% @page_title = t("devise_views.passwords.edit.page_title") %>
<% content_for :title, t("devise_views.passwords.edit.page_title") %>

<div class="space-y-6">
  <div class="text-center">
    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-sky-500 text-lg font-semibold text-white">TF</div>
    <h2 class="mt-4 text-2xl font-semibold text-slate-900"><%= t("devise_views.passwords.edit.title") %></h2>
  </div>
  <%= render "shared/form_errors", resource: resource %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
    <%= f.hidden_field :reset_password_token %>
    <div><%= f.label :password, class: "mb-2 block text-sm font-medium text-slate-700" %><%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "w-full rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm" %></div>
    <div><%= f.label :password_confirmation, class: "mb-2 block text-sm font-medium text-slate-700" %><%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm" %></div>
    <%= f.submit t("devise_views.passwords.edit.submit"), class: "inline-flex w-full justify-center rounded-lg bg-sky-500 px-4 py-2.5 text-sm font-semibold text-white" %>
  <% end %>
</div>
