- @page_title = t("devise_views.sessions.page_title")
- content_for :title, t("devise_views.sessions.page_title")

.space-y-6
  .text-center
    .mx-auto.flex.h-14.w-14.items-center.justify-center.rounded-2xl.bg-sky-500.text-lg.font-semibold.text-white
      Ruby

    %h2.mt-4.text-2xl.font-semibold.text-slate-900
      = t("devise_views.sessions.title")

    %p.mt-2.text-sm.text-slate-500
      = t("devise_views.sessions.description")

  = render "shared/form_errors", resource: resource

  = form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f|

    %div
      = f.label :email, class: "mb-2 block text-sm font-medium text-slate-700"
      = f.email_field :email,
        autofocus: true,
        autocomplete: "email",
        class: "w-full rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700 outline-none transition focus:border-sky-500 focus:bg-white focus:ring-2 focus:ring-sky-500/20",
        placeholder: t("devise_views.sessions.email_placeholder")

    %div
      = f.label :password, class: "mb-2 block text-sm font-medium text-slate-700"
      = f.password_field :password,
        autocomplete: "current-password",
        class: "w-full rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-700 outline-none transition focus:border-sky-500 focus:bg-white focus:ring-2 focus:ring-sky-500/20",
        placeholder: "••••••••"

    .flex.items-center.justify-between.gap-4
      %label.flex.items-center.gap-2.text-sm.text-slate-600
        = f.check_box :remember_me, class: "rounded border-slate-300 text-sky-500 focus:ring-sky-500"
        %span= t("devise_views.sessions.remember_me")

      = link_to t("devise_views.sessions.forgot_password"),
        new_password_path(resource_name),
        class: "text-sm font-semibold text-sky-600 hover:text-sky-700"

    = f.submit t("devise_views.sessions.submit"),
      class: "inline-flex w-full items-center justify-center rounded-lg bg-sky-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-sky-600 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:ring-offset-2"

  .text-center.text-sm.text-slate-500
    %p
      = t("devise_views.sessions.no_account")
      = link_to t("devise_views.sessions.create_one"),
        new_registration_path(resource_name),
        class: "font-semibold text-sky-600 hover:text-sky-700"


