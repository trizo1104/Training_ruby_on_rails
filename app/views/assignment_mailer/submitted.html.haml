%h1
  = t("mailers.assignment.submitted.heading")

%p
  = t("mailers.assignment.submitted.greeting", name: @user.full_name)

%p
  = t("mailers.assignment.submitted.message")

%h2
  = t("mailers.assignment.submitted.content")

= simple_format(@assignment.content)

%h2
  = t("mailers.assignment.submitted.images")

- @assignment.assignment_images.each do |assignment_image|
  %p
    = image_tag attachments[assignment_image.image.filename.to_s].url,
      alt: assignment_image.image.filename.to_s,
      style: "max-width: 800px; width: 100%; height: auto;"
