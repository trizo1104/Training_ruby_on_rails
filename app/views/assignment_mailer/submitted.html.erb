<h1><%= t("mailers.assignment.submitted.heading") %></h1>

<p>
  <%= t("mailers.assignment.submitted.greeting", name: @user.full_name) %>
</p>

<p>
  <%= t("mailers.assignment.submitted.message") %>
</p>

<h2><%= t("mailers.assignment.submitted.content") %></h2>

<%= simple_format(@assignment.content) %>

<h2><%= t("mailers.assignment.submitted.images") %></h2>

<% @assignment.images.each do |image| %>
  <p>
    <%= image_tag attachments[image.filename.to_s].url,
                  alt: image.filename.to_s,
                  style: "max-width: 800px; width: 100%; height: auto;" %>
  </p>
<% end %>
