<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full bg-slate-50">
  <head>
    <title><%= content_for(:title) || t("layouts.application.default_title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t('app.name') %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-full bg-slate-50 text-slate-900">
    <div class="min-h-screen bg-[radial-gradient(circle_at_top,_rgba(14,165,233,0.12),_transparent_55%)] px-4 py-10 sm:px-6 lg:px-8">
      <%= render "shared/flash" %>
      <div class="mx-auto flex min-h-screen max-w-6xl items-center justify-center">
        <div class="w-full max-w-2xl rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-10">
          <div class="mb-4 flex justify-end"><%= render "shared/locale_switcher" %></div>
          <%= yield %>
        </div>
      </div>
    </div>
  </body>
</html>
