<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full bg-slate-50">
  <head>
    <title><%= content_for(:title) || t("layouts.application.default_title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t('app.name') %>">
    <meta name="mobile-web-app-capable" content="yes">

    <%# <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script> %>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-full bg-slate-50 text-slate-900">
    <div class="min-h-screen bg-slate-50">
      <%= render "shared/flash" %>
      <div class="min-h-screen">
        <%= render "shared/sidebar", active_nav: @active_nav || "assignments" %>
        <div class="flex min-h-screen flex-col lg:pl-72" data-controller="image-lightbox">
          <%= render "shared/topbar", title: @page_title || t("layouts.application.workspace") %>
          <%= render "shared/mobile_navigation", active_nav: @active_nav || "assignments" %>
          <main class="flex-1 px-4 py-6 sm:px-6 lg:px-8 lg:pb-8 lg:pt-25">
            <div class="mx-auto flex w-full max-w-7xl flex-col gap-6">
              <%= yield %>
            </div>
          </main>
          <%= render "shared/image_lightbox" %>
        </div>
      </div>
    </div>
  </body>
</html>
